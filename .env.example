# ----------------------------------------------------------------------------
# mixi2 Developer Platform — OAuth2 Client Credentials (required)
# https://developer.mixi.social/
# ----------------------------------------------------------------------------
MIXI2_CLIENT_ID=
MIXI2_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# Optional: override the default mixi2 endpoints.
# Defaults are exported from `mixi2-js/helpers` (tokenUrl / apiAddress).
# Leave unset unless you know you need to override them.
# ----------------------------------------------------------------------------
# MIXI2_TOKEN_URL=
# MIXI2_API_ADDRESS=

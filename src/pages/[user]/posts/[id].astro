---
import SnippetPage from '~/components/SnippetPage.astro';
import { parsePostId } from '~/lib/parse';

export const prerender = false;

// Accept `/handle/posts/id` (the @-less form), but skip system paths.
const user = Astro.params['user'] ?? '';
if (user === 'snippets' || user === 'api' || user === 'posts') {
  return new Response('Not found', { status: 404 });
}
const postId = parsePostId(Astro.params['id'] ?? '');
if (!postId) Astro.response.status = 404;
---

<SnippetPage postId={postId} redirectToRoot={true} />

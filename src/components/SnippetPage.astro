---
import type { Post, User } from 'mixi2-js';
import { PostMediaType } from 'mixi2-js';
import Snippet from '~/components/Snippet.astro';
import SnippetFallback from '~/components/SnippetFallback.astro';
import { fetchPost, fetchPosts, fetchUser, fetchUsers } from '~/lib/mixi2';
import { fetchQuotedPostId } from '~/lib/mixi2-web';
import { postUrl as buildPostUrl, extractMixi2PostRefs } from '~/lib/parse';

interface Props {
  postId: string | null;
}

const { postId } = Astro.props;

const result = postId
  ? await fetchPost(postId)
  : ({ ok: false, reason: 'not_found' } as const);

if (result.ok) {
  Astro.response.headers.set(
    'Cache-Control',
    'public, s-maxage=300, stale-while-revalidate=86400'
  );
} else if (result.reason === 'error') {
  Astro.response.status = 502;
  Astro.response.headers.set('Cache-Control', 'no-store');
} else {
  Astro.response.status = 404;
  Astro.response.headers.set(
    'Cache-Control',
    'public, s-maxage=60, stale-while-revalidate=300'
  );
}

type RelatedContext = { post: Post; user: User | null };

async function fetchRelated(id: string): Promise<RelatedContext | null> {
  const posts = await fetchPosts([id]);
  const p = posts.get(id);
  if (!p) return null;
  const users = await fetchUsers([p.creatorId]);
  return { post: p, user: users.get(p.creatorId) ?? null };
}

// --- Parallel fetch of author, reply parent, and quote target ---------------
let user: User | null = null;
let replyContext: RelatedContext | null = null;
let quoteContext: RelatedContext | null = null;

if (result.ok) {
  const post = result.post;

  const userPromise = post.creatorId
    ? fetchUser(post.creatorId)
    : Promise.resolve(null);

  const replyPromise = post.inReplyToPostId
    ? fetchRelated(post.inReplyToPostId)
    : Promise.resolve(null);

  // Quote: try the mixi.social HTML scrape first; fall back to text URLs
  const quoteIdPromise = (async () => {
    const scraped = await fetchQuotedPostId(post.postId);
    if (scraped && scraped !== post.postId) return scraped;
    const textRef = extractMixi2PostRefs(post.text, 1).find(
      (r) => r.id !== post.postId
    );
    return textRef?.id ?? null;
  })();

  const [resolvedUser, resolvedReply, quoteId] = await Promise.all([
    userPromise,
    replyPromise,
    quoteIdPromise,
  ]);
  user = resolvedUser;
  replyContext = resolvedReply;

  if (quoteId) {
    quoteContext = await fetchRelated(quoteId);
  }
}

// --- OGP / Twitter Card metadata for Discord/Slack/X/Telegram previews -----
const ogSiteName = 'mixi2';
const ogThemeColor = '#ff5a36';
let ogTitle = 'mixi2 post';
let ogDescription = '';
let ogCanonical = postId
  ? `https://mixi.social/posts/${postId}`
  : 'https://mixi.social/';

type OgImage = {
  url: string;
  width: number | null;
  height: number | null;
};
const ogImages: OgImage[] = [];

let ogVideoUrl: string | null = null;
let ogVideoMime: string | null = null;
let ogVideoWidth: number | null = null;
let ogVideoHeight: number | null = null;

function handleOf(u: User | null): string {
  return u?.name ? `@${u.name}` : '@user';
}

function snippetOf(text: string, max = 100): string {
  const t = text.trim().replace(/\s+/g, ' ');
  return t.length > max ? t.slice(0, max) + '…' : t;
}

if (result.ok) {
  const post = result.post;
  const displayName = user?.displayName || user?.name || 'mixi2 user';
  const handle = user?.name ? ` (@${user.name})` : '';
  ogTitle = `${displayName}${handle} on mixi2`;
  ogCanonical = buildPostUrl(post.postId, user?.name);

  // --- Description: fxtwitter-style context lines --------------------------
  const descLines: string[] = [];
  const mainText = post.text.trim();
  if (mainText) descLines.push(mainText);

  if (replyContext) {
    const h = handleOf(replyContext.user);
    const s = snippetOf(replyContext.post.text);
    descLines.push('');
    descLines.push(s ? `↩ Replying to ${h}: ${s}` : `↩ Replying to ${h}`);
  }
  if (quoteContext) {
    const h = handleOf(quoteContext.user);
    const s = snippetOf(quoteContext.post.text);
    descLines.push('');
    descLines.push(s ? `💬 Quoting ${h}: ${s}` : `💬 Quoting ${h}`);
  }
  ogDescription = descLines.join('\n');

  // --- Images: collect ALL media (up to 4); Discord shows them as a grid ---
  for (const m of post.postMediaList.slice(0, 4)) {
    if (m.mediaType === PostMediaType.IMAGE && m.image) {
      ogImages.push({
        url: m.image.largeImageUrl || m.image.smallImageUrl,
        width: m.image.largeImageWidth || m.image.smallImageWidth || null,
        height: m.image.largeImageHeight || m.image.smallImageHeight || null,
      });
    } else if (m.mediaType === PostMediaType.VIDEO && m.video) {
      ogImages.push({
        url: m.video.previewImageUrl,
        width: m.video.previewImageWidth || null,
        height: m.video.previewImageHeight || null,
      });
      if (!ogVideoUrl && m.video.videoUrl) {
        ogVideoUrl = m.video.videoUrl;
        ogVideoMime = m.video.videoMimeType || 'video/mp4';
        ogVideoWidth = m.video.videoWidth || null;
        ogVideoHeight = m.video.videoHeight || null;
      }
    }
  }
}

const ogTitleClamped =
  ogTitle.length > 70 ? ogTitle.slice(0, 70) + '…' : ogTitle;
const ogDescriptionClamped =
  ogDescription.length > 320
    ? ogDescription.slice(0, 320) + '…'
    : ogDescription;
const twitterCard = ogImages.length > 0 ? 'summary_large_image' : 'summary';
const primaryImage = ogImages[0] ?? null;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{ogTitleClamped}</title>
    {
      ogDescriptionClamped && (
        <meta name="description" content={ogDescriptionClamped} />
      )
    }
    <link rel="canonical" href={ogCanonical} />

    <meta property="og:type" content="article" />
    <meta property="og:site_name" content={ogSiteName} />
    <meta property="og:title" content={ogTitleClamped} />
    {
      ogDescriptionClamped && (
        <meta property="og:description" content={ogDescriptionClamped} />
      )
    }
    <meta property="og:url" content={ogCanonical} />
    {
      ogImages.map((img) => (
        <Fragment>
          <meta property="og:image" content={img.url} />
          {img.width && (
            <meta property="og:image:width" content={String(img.width)} />
          )}
          {img.height && (
            <meta property="og:image:height" content={String(img.height)} />
          )}
        </Fragment>
      ))
    }
    {
      ogVideoUrl && (
        <Fragment>
          <meta property="og:video" content={ogVideoUrl} />
          <meta property="og:video:url" content={ogVideoUrl} />
          <meta property="og:video:secure_url" content={ogVideoUrl} />
          {ogVideoMime && (
            <meta property="og:video:type" content={ogVideoMime} />
          )}
          {ogVideoWidth && (
            <meta property="og:video:width" content={String(ogVideoWidth)} />
          )}
          {ogVideoHeight && (
            <meta property="og:video:height" content={String(ogVideoHeight)} />
          )}
        </Fragment>
      )
    }

    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={ogTitleClamped} />
    {
      ogDescriptionClamped && (
        <meta name="twitter:description" content={ogDescriptionClamped} />
      )
    }
    {primaryImage && <meta name="twitter:image" content={primaryImage.url} />}
    {user?.name && <meta name="twitter:creator" content={`@${user.name}`} />}

    <meta name="theme-color" content={ogThemeColor} />
    <style>
      html,
      body {
        margin: 0;
        padding: 0;
        background: transparent;
        color-scheme: light dark;
      }
      body {
        font-family:
          -apple-system, BlinkMacSystemFont, 'Hiragino Sans', 'Yu Gothic UI',
          'Segoe UI', Roboto, sans-serif;
      }
      #root {
        padding: 0;
      }
    </style>
  </head>
  <body>
    <div id="root">
      {
        result.ok ? (
          <Snippet post={result.post} user={user} />
        ) : (
          <SnippetFallback
            postId={postId ?? ''}
            reason={result.reason}
            message={result.reason === 'error' ? result.message : undefined}
          />
        )
      }
    </div>

    <script is:inline>
      (function () {
        function postHeight() {
          var h = document.documentElement.scrollHeight;
          try {
            window.parent.postMessage(
              { type: 'mixi2-embedder-snippet-height', height: h },
              '*'
            );
          } catch (_) {}
        }
        postHeight();
        if (document.readyState !== 'complete') {
          window.addEventListener('load', postHeight, { once: true });
        }
        if (typeof ResizeObserver !== 'undefined') {
          new ResizeObserver(postHeight).observe(document.documentElement);
        } else {
          window.addEventListener('resize', postHeight);
        }
        document.addEventListener('readystatechange', postHeight);
        var imgs = document.images;
        for (var i = 0; i < imgs.length; i++) {
          if (!imgs[i].complete) imgs[i].addEventListener('load', postHeight);
        }
      })();
    </script>
  </body>
</html>

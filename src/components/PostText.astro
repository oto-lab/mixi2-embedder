---
import { segmentText } from '~/lib/text';
import { userUrl } from '~/lib/parse';

interface Props {
  text: string;
  excludeUrls?: string[] | undefined;
}

const { text, excludeUrls } = Astro.props;
const excluded = new Set(excludeUrls ?? []);
const segments = segmentText(text);
---

<p class="post-text">
  {
    segments.map((seg) => {
      if (seg.type === 'url') {
        if (excluded.has(seg.value)) return null;
        return (
          <a href={seg.value} target="_blank" rel="noopener noreferrer ugc">
            {seg.value}
          </a>
        );
      }
      if (seg.type === 'mention') {
        return (
          <a
            href={userUrl(seg.handle)}
            target="_blank"
            rel="noopener noreferrer ugc"
          >
            {seg.value}
          </a>
        );
      }
      if (seg.type === 'hashtag') {
        return (
          <a
            href={`https://mixi.social/search?q=${encodeURIComponent(seg.value)}`}
            target="_blank"
            rel="noopener noreferrer ugc"
          >
            {seg.value}
          </a>
        );
      }
      return <span>{seg.value}</span>;
    })
  }
</p>

<style>
  .post-text {
    margin: 0;
    color: var(--color-fg);
    font-size: 15px;
    line-height: 1.55;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .post-text a {
    color: var(--color-accent);
    text-decoration: none;
  }
  .post-text a:hover {
    text-decoration: underline;
  }
</style>

{
  "name": "mixi2-embedder",
  "version": "0.1.0",
  "description": "Embeddable snippets for mixi2 posts. Deploy to Vercel.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "license": "Apache-2.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/svelte": "^8.1.1",
    "@astrojs/vercel": "^10.0.7",
    "astro": "^6.3.3",
    "mixi2-js": "^1.5.3",
    "svelte": "^5.55.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tsconfig/strictest": "^2.0.8",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  }
}
